@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }

<div class="content-card narrow-card">
    <h2 class="section-title">Change Password</h2>

    <form asp-action="ChangePassword" method="post" class="vstack gap-3">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

        <div>
            <label asp-for="CurrentPassword" class="form-label"></label>
            <input asp-for="CurrentPassword" class="form-control rounded-4" />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control rounded-4" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control rounded-4" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button class="btn btn-success rounded-4">Update Password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
