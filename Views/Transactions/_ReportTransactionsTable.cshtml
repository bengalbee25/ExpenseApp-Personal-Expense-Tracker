@model IEnumerable<Transaction>

<div class="table-responsive">
    <table class="table align-middle custom-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Category</th>
                <th>Amount</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No transactions found.</td></tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TransactionDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-capitalize">@item.Type</td>
                        <td>@item.Category</td>
                        <td class="fw-semibold">BDT @item.Amount.ToString("0.00")</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
