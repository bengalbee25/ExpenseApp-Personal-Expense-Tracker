@model SearchTransactionsViewModel
@{ ViewData["Title"] = "Search Transactions"; }

<div class="content-card mb-4">
    <h2 class="section-title">Search Transactions</h2>
    <p class="text-muted">Search by date (dd/MM/yyyy), type, category, amount, or description.</p>

    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-10">
            <label class="form-label">Search</label>
            <input type="text" name="query" value="@Model.Query" class="form-control rounded-4" placeholder="Type to search" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-success rounded-4 w-100">Search</button>
        </div>
    </form>
    <div class="small text-muted mt-2">@Model.Transactions.Count transaction(s) found.</div>
</div>

<div class="content-card">
    <partial name="_TransactionsTable" model="Model.Transactions" />
</div>
