@model ExpenseTracker.Web.Controllers.ManageTransactionsPageViewModel
@{ ViewData["Title"] = Model.Title; }

<div class="row g-4">
    <div class="col-12">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <h2 class="section-title mb-1">@Model.Title</h2>
                    <p class="text-muted mb-0">Add and manage your @Model.PageType transactions.</p>
                </div>
                <span class="type-badge @(Model.PageType == "income" ? "type-income" : "type-expense") text-capitalize">
                    @Model.PageType
                </span>
            </div>

            <form asp-action="Create" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input asp-for="Form.Type" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <div class="col-md-2">
                    <label asp-for="Form.Amount" class="form-label"></label>
                    <input asp-for="Form.Amount" class="form-control rounded-4" type="number" step="0.01" placeholder="0.00" />
                    <span asp-validation-for="Form.Amount" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Form.Category" class="form-label"></label>
                    <input asp-for="Form.Category" class="form-control rounded-4" placeholder="Enter category" />
                    <span asp-validation-for="Form.Category" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Form.TransactionDate" class="form-label">Date</label>
                    <input asp-for="Form.TransactionDate" class="form-control rounded-4" type="date" />
                    <span asp-validation-for="Form.TransactionDate" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Form.Description" class="form-label"></label>
                    <input asp-for="Form.Description" class="form-control rounded-4" placeholder="Optional note" />
                    <span asp-validation-for="Form.Description" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-success rounded-4 px-4">Add @(Model.PageType == "income" ? "Income" : "Expense")</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-12">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h3 class="section-title mb-0">@Model.Title List</h3>
                <span class="text-muted small">@Model.Transactions.Count transaction(s)</span>
            </div>
            <partial name="_TransactionsTable" model="Model.Transactions" />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
