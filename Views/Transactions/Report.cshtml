@model DashboardViewModel
@{ ViewData["Title"] = "Generate Report"; }

<div class="content-card mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h2 class="section-title mb-1">Generate Report</h2>
        <p class="text-muted mb-0">This report includes summary cards, charts, and all transactions.</p>
    </div>
    <button type="button" id="downloadPdfBtn" class="btn btn-success rounded-4">Download PDF</button>
</div>

<div id="reportArea" class="vstack gap-4">
    <div class="row g-4">
        <div class="col-md-4"><div class="summary-card"><div class="summary-label">Total Balance</div><div class="summary-value">BDT @Model.Summary.Balance.ToString("0.00")</div></div></div>
        <div class="col-md-4"><div class="summary-card"><div class="summary-label">Total Income</div><div class="summary-value">BDT @Model.Summary.Income.ToString("0.00")</div></div></div>
        <div class="col-md-4"><div class="summary-card"><div class="summary-label">Total Expenses</div><div class="summary-value">BDT @Model.Summary.Expense.ToString("0.00")</div></div></div>
    </div>

    <div class="content-card"><h3 class="section-title">Income vs Expense (Monthly)</h3><canvas id="reportBarChart" height="120"></canvas></div>
    <div class="content-card">
        <h3 class="section-title">Expenses by Category</h3>

        <div style="height: 550px; width: 650px; margin: auto;">
            <canvas id="reportPieChart"></canvas>
        </div>
    </div>
    <div class="content-card"><h3 class="section-title">Income & Expense Trend (Line)</h3><canvas id="reportLineChart" height="100"></canvas></div>
    <div class="content-card mt-5">
        <h3 class="section-title">All Transactions</h3>
        <partial name="_ReportTransactionsTable" model="Model.AllTransactions" />
    </div>
</div>

@section Scripts {
<script>
    const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyItems.Select(x => x.MonthLabel)));
    const monthlyIncome = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyItems.Select(x => x.Income)));
    const monthlyExpense = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyItems.Select(x => x.Expense)));
    const pieLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpensePieItems.Select(x => x.Category)));
    const pieAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpensePieItems.Select(x => x.Amount)));

    new Chart(document.getElementById('reportBarChart'), {
        type: 'bar',
        data: { labels: monthlyLabels, datasets: [
            { label: 'Income', data: monthlyIncome, backgroundColor: '#3b82f6' },
            { label: 'Expense', data: monthlyExpense, backgroundColor: '#f97316' }
        ] }
    });
            new Chart(document.getElementById('reportPieChart'), {
            type: 'pie',
            data: {
                labels: pieLabels,
                datasets: [{
                    data: pieAmounts,
                    backgroundColor: ['#10b981','#ef4444','#3b82f6','#f59e0b','#8b5cf6','#14b8a6','#ec4899']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    new Chart(document.getElementById('reportLineChart'), {
        type: 'line',
        data: { labels: monthlyLabels, datasets: [
            { label: 'Income', data: monthlyIncome, borderColor: '#16a34a', fill: false, tension: .3 },
            { label: 'Expense', data: monthlyExpense, borderColor: '#dc2626', fill: false, tension: .3 }
        ] }
    });

    document.getElementById('downloadPdfBtn').addEventListener('click', async function () {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF('p', 'mm', 'a4');
        const reportArea = document.getElementById('reportArea');
        const canvas = await html2canvas(reportArea, { scale: 2, useCORS: true });
        const imgData = canvas.toDataURL('image/png');
        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const imgWidth = pageWidth - 20;
        const imgHeight = canvas.height * imgWidth / canvas.width;
        let heightLeft = imgHeight;
        let position = 10;
        doc.addImage(imgData, 'PNG', 10, position, imgWidth, imgHeight);
        heightLeft -= (pageHeight - 20);
        while (heightLeft > 0) {
            position = heightLeft - imgHeight + 10;
            doc.addPage();
            doc.addImage(imgData, 'PNG', 10, position, imgWidth, imgHeight);
            heightLeft -= (pageHeight - 20);
        }
        doc.save('expense-report.pdf');
    });
</script>
}
